{{define "layout"}}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{template "title" .}}</title>
    <!-- Google Fonts - Comfortaa for QueueBuzz logo/wordmark branding -->
    <link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@700;900&display=swap" rel="stylesheet">
</head>
<body style="margin: 0; padding: 0; background-color: #F7F3EE; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1A0A2E;">
    <div style="max-width: 600px; margin: 0 auto; padding: 40px 20px;">
        <!-- QueueBuzz Logo & Wordmark Header -->
        <div style="text-align: center; margin-bottom: 32px;">
            <a href="{{.FrontendURL}}" style="text-decoration: none; display: inline-block;">
                <table border="0" cellpadding="0" cellspacing="0" style="margin: 0 auto; border-collapse: collapse;">
                    <tr>
                        <td style="vertical-align: middle; padding-right: 6px;">
                            <img src="{{.FrontendURL}}/icons/icon-192x192.png" width="48" height="48" style="display: block; width: 48px; height: 48px; border: 0;" alt="QueueBuzz Logo">
                        </td>
                        <td style="vertical-align: middle; text-align: left;">
                            <div style="font-family: 'Comfortaa', 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1A0A2E; line-height: 1;">
                                <span style="font-size: 26px; font-weight: 900; letter-spacing: -1px; display: block; overflow: hidden; line-height: 1;">ueue</span>
                                <span style="font-size: 18px; font-weight: 700; letter-spacing: -0.5px; display: block; overflow: hidden; margin-top: 2px; line-height: 1;">Buzz</span>
                            </div>
                        </td>
                    </tr>
                </table>
            </a>
        </div>
        <div style="background-color: #FFFFFF; border-radius: 24px; padding: 40px; box-shadow: 0 4px 24px rgba(26, 10, 46, 0.08);">
            {{template "content" .}}
        </div>
        <div style="text-align: center; font-size: 12px; color: #7B6B95; margin-top: 32px;">
            &copy; {{.Year}} QueueBuzz. All rights reserved.<br>
            Do not reply to this email.
        </div>
    </div>
</body>
</html>
{{end}}
