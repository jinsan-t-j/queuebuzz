{{define "title"}}Subscription Renewing Soon — QueueBuzz{{end}}

{{define "content"}}
<h1 style="font-size: 24px; margin-top: 0;">Renewal Reminder 🔔</h1>
<p style="line-height: 1.6; margin: 16px 0;">Your <strong>{{.PlanName}}</strong> subscription renews in <strong>{{.DaysUntil}} day{{if ne .DaysUntil 1}}s{{end}}</strong>.</p>
<div style="background-color: #F7F3EE; border-radius: 16px; padding: 20px; margin: 24px 0;">
    <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
        <tr>
            <td style="padding: 8px 0; color: #7B6B95;">Plan</td>
            <td style="padding: 8px 0; font-weight: bold; text-align: right;">{{.PlanName}}</td>
        </tr>
        <tr>
            <td style="padding: 8px 0; color: #7B6B95;">Renewal Date</td>
            <td style="padding: 8px 0; font-weight: bold; text-align: right;">{{.RenewalDate}}</td>
        </tr>
        <tr>
            <td style="padding: 8px 0; color: #7B6B95;">Amount</td>
            <td style="padding: 8px 0; font-weight: bold; text-align: right;">{{.FormattedAmount}}</td>
        </tr>
    </table>
</div>
<p style="line-height: 1.6; margin: 16px 0;">No action needed — your payment method on file will be charged automatically. If you'd like to make changes, visit your dashboard.</p>
<div style="text-align: center;">
    <a href="{{.DashboardLink}}" style="display: inline-block; background-color: #00E5A0; color: #1A0A2E !important; padding: 12px 32px; border-radius: 100px; text-decoration: none; font-weight: bold; margin: 24px 0;">Manage Subscription</a>
</div>
{{end}}

{{template "layout" .}}
